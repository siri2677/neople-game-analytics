# 게임별로 Neople Developers에서 발급받은 API Key를 입력합니다.
DNF_API_KEY=replace_with_dnf_key
CYPHERS_API_KEY=replace_with_cyphers_key

# 던파: all 또는 특정 서버 ID를 쉼표로 구분
DNF_SERVERS=all
# 명성 구간은 최대 2,000 단위로 나누어 수집
DNF_FAME_BANDS=50000:52000,52000:54000,54000:56000
DNF_SAMPLE_LIMIT=30
# 장비에서 발견된 아이템 중 경매장 시세를 조회할 최대 아이템 수
DNF_AUCTION_ITEM_LIMIT=30

# 사이퍼즈: 닉네임 또는 이미 알고 있는 playerId를 입력
CYPHERS_NICKNAMES=
CYPHERS_PLAYER_IDS=
CYPHERS_GAME_TYPE=rating
CYPHERS_START_DATE=
CYPHERS_END_DATE=
CYPHERS_MATCH_LIMIT=50
CYPHERS_MATCH_DETAIL_LIMIT=100

