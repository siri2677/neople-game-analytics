# NEOPLE Game Analytics 환경 설정 가이드
#
# 사용 방법
# 1) 이 파일을 같은 폴더의 .env로 복사합니다.
#    PowerShell: Copy-Item .env.example .env
# 2) 아래 NEOPLE_API_KEY에 본인의 네오플 API Key를 입력합니다.
# 3) API Key와 비밀번호가 들어간 .env 파일은 GitHub에 올리지 않습니다.
#
# 실행 순서
#   python -m src.collect --game all
#   python -m src.transform
#   python -m src.load_postgres --mode replace
#
# 네오플 API Key 발급
#   https://developers.neople.co.kr/manage/app/list
#
# API Key는 채팅이나 GitHub에 공유하지 마세요.

# -----------------------------------------------------------------------------
# 1. Neople API 인증
# -----------------------------------------------------------------------------

# 필수: 네오플 Developers에서 발급받은 본인의 API Key
NEOPLE_API_KEY=replace_with_your_neople_api_key

# -----------------------------------------------------------------------------
# 2. 던전앤파이터 수집 설정 (프로젝트 비중 60%)
# -----------------------------------------------------------------------------

# all 또는 특정 서버 ID를 쉼표로 구분합니다.
# 예: DNF_SERVERS=all
# 예: DNF_SERVERS=cain,bakal
DNF_SERVERS=all

# 명성 구간은 API 제한에 맞춰 최대 2,000 단위로 나눕니다.
# 형식: 최소명성:최대명성,최소명성:최대명성
DNF_FAME_BANDS=50000:52000,52000:54000,54000:56000

# 명성 구간별로 수집할 캐릭터 수
DNF_SAMPLE_LIMIT=30

# 장착 장비에서 발견한 아이템 중 경매장 시세를 조회할 최대 아이템 수
DNF_AUCTION_ITEM_LIMIT=30

# -----------------------------------------------------------------------------
# 3. 사이퍼즈 수집 설정 (프로젝트 비중 40%)
# -----------------------------------------------------------------------------

# 특정 닉네임이나 playerId를 입력하지 않습니다.
# 전체 캐릭터 공식 랭킹을 수집하고, 공식 통합 랭킹 상위 플레이어를
# 재현 가능한 표본으로 자동 선정합니다.

# 캐릭터 공식 랭킹 지표
# winRate: 승률, winCount: 승리 수, killCount: 킬,
# assistCount: 도움, exp: 경험치
CYPHERS_CHARACTER_RANKING_TYPES=winRate,winCount,killCount,assistCount,exp

# 캐릭터별 공식 랭킹에서 가져올 최대 행 수 (API 최대 1,000)
CYPHERS_RANKING_LIMIT=1000

# 아이템·매칭 분석에 사용할 공식 통합 랭킹 상위 플레이어 수
# 이 결과는 전체 유저가 아닌 '상위 랭커 표본'으로 해석합니다.
CYPHERS_TOP_PLAYER_LIMIT=50

# rating: 공식전, normal: 일반전
CYPHERS_GAME_TYPE=rating

# 비워 두면 실행일 기준 최근 30일을 사용합니다.
# 사이퍼즈 API의 기간 검색 제한을 고려해 최대 90일 이내로 설정합니다.
# 형식 예: 2026-08-01 00:00
CYPHERS_START_DATE=
CYPHERS_END_DATE=

# 상위 랭커별로 가져올 매칭 기록 수
CYPHERS_MATCH_LIMIT=50

# 상세 분석할 고유 매칭 수
CYPHERS_MATCH_DETAIL_LIMIT=300

# -----------------------------------------------------------------------------
# 4. PostgreSQL / Power BI 연결 설정
# -----------------------------------------------------------------------------

# 외부 관리형 PostgreSQL 접속 정보로 입력합니다.
# 예: managed PostgreSQL provider가 발급한 호스트 주소
POSTGRES_HOST=replace_with_managed_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=replace_with_managed_postgres_database
POSTGRES_USER=replace_with_managed_postgres_user
POSTGRES_PASSWORD=replace_with_managed_postgres_password
POSTGRES_SSLMODE=require

# Power BI Desktop 연결 정보도 동일하게 입력합니다.
#   Server: POSTGRES_HOST 값
#   Port: 5432
#   Database: POSTGRES_DB 값
#   Username: POSTGRES_USER 값
#   Password: POSTGRES_PASSWORD 값
#
# 로컬 docker compose PostgreSQL을 사용할 때만 다음처럼 변경합니다.
#   POSTGRES_HOST=localhost
#   POSTGRES_USER=neople
#   POSTGRES_PASSWORD=neople_local_only
#   POSTGRES_SSLMODE=disable
