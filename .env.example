NEOPLE_API_KEY=replace_with_your_key

# 던파: all 또는 특정 서버 ID를 쉼표로 구분
DNF_SERVERS=all
# 명성 구간은 최대 2,000 단위로 나누어 수집
DNF_FAME_BANDS=50000:52000,52000:54000,54000:56000
DNF_SAMPLE_LIMIT=30
# 장비에서 발견된 아이템 중 경매장 시세를 조회할 최대 아이템 수
DNF_AUCTION_ITEM_LIMIT=30

# 사이퍼즈: 전체 캐릭터 공식 랭킹을 자동 수집하고,
# 통합 랭킹 상위 플레이어를 재현 가능한 표본으로 사용
CYPHERS_CHARACTER_RANKING_TYPES=winRate,winCount,killCount,assistCount,exp
CYPHERS_RANKING_LIMIT=1000
CYPHERS_TOP_PLAYER_LIMIT=50
CYPHERS_GAME_TYPE=rating
CYPHERS_START_DATE=
CYPHERS_END_DATE=
CYPHERS_MATCH_LIMIT=50
CYPHERS_MATCH_DETAIL_LIMIT=300

# PostgreSQL / Power BI source database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=neople
POSTGRES_USER=neople
POSTGRES_PASSWORD=neople_local_only
